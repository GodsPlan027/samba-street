---
import { Image, getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import DonateBox from "../components/DonateBox.astro";
import SeasonSquares from "../components/SeasonSquares.astro";
import BudgetBars from "../components/BudgetBars.astro";
import { CONTACT_EMAIL } from "../site";
import { getPublishedPosts, postUrl, formatDate, isoDate } from "../journal";
import { startBudget, publicFinances, loadSessions, goal, euro } from "../transparency";
import { money } from "../dashboard/finances";

import hero from "../assets/site/hero.jpg";
import training from "../assets/site/training.jpg";
import tyres from "../assets/site/tyres.jpg";
import ball from "../assets/site/ball.jpg";
import boots from "../assets/site/boots.jpg";
import centre from "../assets/site/khayelitsha-centre.jpg";
import tournament from "../assets/site/tournament.jpg";

// Numbers from src/site.ts and the CSV files in data/.
const budget = startBudget();
const finances = await publicFinances();
const sessions = loadSessions();
const progress = await goal();

// Latest journal posts, shown once there are any.
const posts = (await getPublishedPosts()).slice(0, 3);

// The hero photo as link preview (WhatsApp, Facebook and so on).
const shareImage = await getImage({ src: hero, width: 1200, format: "jpg" });

const overview = [
  { when: "2010", what: "The goal" },
  { when: "Nov 2026", what: "What we saw" },
  { when: "Dec 2026", what: "We are here", here: true },
  { when: "Mar 2027", what: "First training" },
  { when: "Every 2 months", what: "A tournament" },
  { when: "Dec 2027", what: "A full season" },
];

const observations = [
  {
    title: "Two balls for everyone",
    text: "So during training, many kids stand on the side, watching.",
  },
  {
    title: "No cones, ladders or bibs",
    text: "Car tyres stand in for cones, but they're too big for passing drills. One team takes off their shirts to tell the teams apart.",
  },
  {
    title: "One goal, shared with rugby",
    text: "The football team trains right through the rugby team. Finishing drills often can't happen.",
  },
  {
    title: "One coach, no licence",
    text: "He runs every session and arranges the matches. There's no budget for a licence, and his assistant hardly has time.",
  },
  {
    title: "Three drills",
    text: "One for finishing, one for passing, one for positions. Every session looks exactly the same.",
  },
  {
    title: "Sessions cancelled",
    text: "Training often doesn't happen, because there aren't enough coaches.",
  },
];

// Weeks with training in a year, as 52 small blocks.
const weeksNow = Array.from({ length: 52 }, (_, i) => i === 37 || i === 38);
const weeksFromMarch = Array.from({ length: 52 }, (_, i) => i >= 9 && i <= 48);
---

<BaseLayout image={shareImage.src}>
  <!-- Opening: the photo fills the first screen, and all of its text fits on it. -->
  <header class="hero">
    <Image
      class="hero-img"
      src={hero}
      alt="Kids playing a football match on a dusty school field"
      widths={[640, 960, 1280, 1920, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-shade"></div>

    <SiteHeader overlay />

    <div class="wrap hero-content">
      <div>
        <p class="hero-date">11 June 2010 · Soccer City, Johannesburg</p>
        <h1>Bring back Samba football<span class="dot">.</span></h1>
      </div>
      <p class="intro">
        Siphiwe Tshabalala scored the first goal of the 2010 World Cup. A month later, the
        Netherlands played the final in the same stadium. That goal is our badge: football played
        for joy. We're bringing it to Khayelitsha, Cape Town.
      </p>
    </div>
    <ol class="wrap overview" aria-label="The season at a glance">
      {
        overview.map((o) => (
          <li class:list={{ here: o.here }}>
            {o.when}
            <span>{o.what}</span>
          </li>
        ))
      }
    </ol>
  </header>

  <main class="wrap" id="story">
    <!-- November 2026: what we saw -->
    <article class="item">
      <div class="when">
        <p class="month">November 2026</p>
        <span class="label">Two weeks in Khayelitsha</span>
      </div>
      <div class="body reveal">
        <h2>Four teams. Two balls. One coach.</h2>
        <p class="lead">
          We spent two weeks at Nkazimlo Primary School in Khayelitsha, one of the largest
          townships in South Africa. The school has four teams, boys under 10, under 12 and under 14
          and girls under 14: about 80 kids.
        </p>
        <div class="photos">
          <figure class="big">
            <Image
              src={training}
              alt="A youth team running together across a dirt pitch"
              widths={[480, 800, 1200]}
              sizes="(min-width: 1200px) 580px, 62vw"
            />
          </figure>
          <figure class="small">
            <Image
              class="gray"
              src={tyres}
              alt="A pile of old car tyres"
              widths={[320, 640]}
              sizes="(min-width: 1200px) 290px, 31vw"
            />
          </figure>
          <figure class="small">
            <Image
              src={ball}
              alt="A worn football lying on the grass"
              widths={[320, 640]}
              sizes="(min-width: 1200px) 290px, 31vw"
            />
          </figure>
        </div>
        <div class="facts">
          {
            observations.map((o) => (
              <p>
                <strong>{o.title}</strong>
                {o.text}
              </p>
            ))
          }
        </div>
        <figure class="boots">
          <Image
            src={boots}
            alt="Worn white football boots on a red running track"
            widths={[640, 960, 1280]}
            sizes="(min-width: 1200px) 870px, 100vw"
          />
          <div class="boots-shade"></div>
          <p>No boots, no match.</p>
        </figure>
        <p class="lead">
          Most kids have boots with holes and missing studs. In the Netherlands, nobody would wear
          them anymore. Some train in socks or sneakers. At matches, kids without football boots
          aren't allowed to play.
        </p>
        <div class="weeks">
          <p class="label">Under-10s and under-12s, worst case: weeks with training in a year</p>
          <div class="strip" aria-hidden="true">
            {weeksNow.map((on) => <i class:list={{ on }} />)}
          </div>
          <p class="weeks-cap">
            <strong>2 of 52 weeks.</strong> The teams only train when a match is coming up. For the under-10s
            and under-12s, that's the two weeks before their one knockout tournament. The under-14s haven't
            trained since their league ended, three months ago.
          </p>
        </div>
      </div>
    </article>

    <!-- December 2026: we are here -->
    <article class="item here" id="now">
      <div class="when">
        <p class="month">December 2026</p>
        <span class="here-tag">We are here</span>
      </div>
      <div class="body reveal">
        <h2>To start in March, we need {euro(budget.total)} before selection day.</h2>
        <p class="lead">
          Stichting Samba Street is registered in the Netherlands this month. This is what has to be
          there on the first day of training:
        </p>
        <ul class="needs">
          {
            budget.items.map((i) => (
              <li>
                <span>{i.item}</span>
                <span class="num">{euro(i.amount)}</span>
              </li>
            ))
          }
        </ul>
        <div class="goal">
          <p class="goal-big num">
            {money(progress.raised)} <span>of {euro(progress.total)} raised</span>
          </p>
          <div class="bar"><span style={`width: ${progress.percent}%`}></span></div>
          <p class="label">{progress.donations}</p>
        </div>
        <div class="ctas">
          <a class="btn" href="/donate/">Donate</a>
          <a class="btn-line" href="/donate/">Give monthly →</a>
        </div>
      </div>
    </article>

    <!-- March 2027 and on: the plan -->
    <article class="item">
      <div class="when">
        <p class="month">March 2027</p>
        <span class="label">Selection day, first training</span>
      </div>
      <div class="body reveal">
        <h2>Selection day. Then training, twice a week.</h2>
        <p class="lead">
          Every boy from the under-10 and under-12 teams can take part in selection day. We form one
          team of about 20. The school's coach and a new coach, both paid per session, train them
          twice a week, the whole school year. Every session is logged: date, players, minutes and
          drills.
        </p>
        <p class="lead">
          All four teams get gear, the girls too: balls, cones, ladders, bibs, two small goals,
          football boots and shirts.
        </p>
        <div class="weeks">
          <p class="label">From March 2027: weeks with training</p>
          <div class="strip" aria-hidden="true">
            {weeksFromMarch.map((on) => <i class:list={{ on }} />)}
          </div>
          <p class="weeks-cap">
            <strong>Every school week.</strong> Twice a week, from March to the end of the school year.
          </p>
        </div>
        <figure class="wide">
          <Image
            src={centre}
            alt="Kids running on the pitch of the Football for Hope Centre in Khayelitsha"
            widths={[640, 960, 1440]}
            sizes="(min-width: 1200px) 870px, 100vw"
          />
        </figure>
      </div>
    </article>

    <article class="item">
      <div class="when">
        <p class="month">Every two months</p>
        <span class="label">Tournaments</span>
      </div>
      <div class="body reveal">
        <h2>A tournament of our own.</h2>
        <p class="lead">
          So the kids actually get to play matches, instead of one knockout game a year.
        </p>
        <figure class="wide">
          <Image
            src={tournament}
            alt="A youth match on a dusty pitch, the goalkeeper ready in goal"
            widths={[640, 960, 1200]}
            sizes="(min-width: 1200px) 870px, 100vw"
          />
        </figure>
      </div>
    </article>

    <article class="item">
      <div class="when">
        <p class="month">December 2027</p>
        <span class="label">End of the school year</span>
      </div>
      <div class="body reveal">
        <h2>One full season, logged session by session.</h2>
        <p class="lead">At the end of the school year, you can see every session and every euro.</p>
      </div>
    </article>

    <article class="item">
      <div class="when">
        <p class="month">2028</p>
        <span class="label">Growing</span>
      </div>
      <div class="body reveal">
        <h2>Then the next team.</h2>
        <p class="lead">We grow step by step, once one team trains consistently.</p>
      </div>
    </article>

    <!-- Follow the season: every session gets a square -->
    <section class="block" aria-labelledby="season-title">
      <p class="label">Follow the season</p>
      <div class="reveal">
        <h2 id="season-title">Every session gets a square.</h2>
        <p class="lead">Squares fill in as sessions happen: date, players, minutes and drills.</p>
        <SeasonSquares />
      </div>
    </section>

    {
      posts.length > 0 && (
        <section class="block" aria-labelledby="journal-title">
          <p class="label" id="journal-title">From the journal</p>
          <div class="reveal">
            <div class="posts">
              {posts.map((post) => (
                <a href={postUrl(post)}>
                  <Image src={post.data.cover} alt="" widths={[480, 720]} sizes="(min-width: 900px) 290px, 100vw" />
                  <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
                  <h3>{post.data.title}</h3>
                </a>
              ))}
            </div>
            <a class="btn-line more" href="/journal/">All journal entries →</a>
          </div>
        </section>
      )
    }

    <!-- Where it goes: budget 2027 as bars, then money in and out -->
    <section class="block" aria-labelledby="budget-title">
      <p class="label">Where it goes</p>
      <div class="reveal">
        <h2 id="budget-title">Budget 2027. Every euro in and out is public.</h2>
        <div class="budget">
          <BudgetBars />
        </div>
        <div class="inout">
          <div>
            <p class="label">Money in</p>
            <p class="big num">{money(finances.moneyIn)}</p>
          </div>
          <div>
            <p class="label">Money out</p>
            <p class="big num">{money(finances.moneyOut)}</p>
          </div>
          <div>
            <p class="label">Sessions held</p>
            <p class="big num">{sessions.length}</p>
          </div>
        </div>
        <a class="btn-line more" href="/where-it-goes/">Every session and every euro →</a>
      </div>
    </section>
  </main>

  <!-- Donate -->
  <section class="give" id="donate">
    <div class="wrap give-inner">
      <div>
        <h2>The season starts in March<span class="dot">.</span></h2>
        <p class="sub">Help it start on time, and keep it going all year with a monthly gift.</p>
      </div>
      <DonateBox tone="dark" />
    </div>
  </section>

  <!-- Funds, companies, clubs -->
  <section class="wrap partners" aria-labelledby="partners-title">
    <p class="label" id="partners-title">Giving as an organisation?</p>
    <div class="partner-grid">
      <div>
        <h3>Funds</h3>
        <p>Project plan, budget and annual figures on request.</p>
        <a class="btn-line" href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent("Samba Street: support from a fund")}`}
          >Get in touch →</a
        >
      </div>
      <div>
        <h3>Companies</h3>
        <p>Support the academy as a company.</p>
        <a class="btn-line" href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent("Samba Street: support from a company")}`}
          >Get in touch →</a
        >
      </div>
      <div>
        <h3>Football clubs</h3>
        <p>Bring your club and its members on board.</p>
        <a class="btn-line" href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent("Samba Street: support from a football club")}`}
          >Get in touch →</a
        >
      </div>
    </div>
  </section>

  <SiteFooter line>
    <p class="credits">
      Photos: Thato Moiketsi and others via Pexels; Andrea Grips (<a
        href="https://commons.wikimedia.org/wiki/File:Khayelitsha_Football_for_Hope_Centre.jpg"
        >CC BY-SA 3.0</a
      >) via Wikimedia Commons.
    </p>
  </SiteFooter>

  <script>
    // Fade blocks in as they scroll into view.
    const els = document.querySelectorAll(".reveal");
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }),
        { threshold: 0.08 },
      );
      els.forEach((el) => io.observe(el));
    } else {
      els.forEach((el) => el.classList.add("in"));
    }
  </script>
</BaseLayout>

<style>
  img {
    display: block;
    max-width: 100%;
  }
  figure {
    margin: 0;
  }
  ol,
  ul {
    margin-top: 0;
    margin-bottom: 0;
    padding: 0;
    list-style: none;
  }
  blockquote {
    margin: 0;
  }

  /* ---------- Opening ---------- */
  /* --fold is the height of the first screen (screenshot tools set it to a fixed number). */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: var(--fold, 100svh);
    color: #fff;
    overflow: hidden;
    background: #3b3329;
  }
  .hero :global(.hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 60%;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.45) 0%,
      rgba(0, 0, 0, 0) 26%,
      rgba(0, 0, 0, 0.2) 48%,
      rgba(0, 0, 0, 0.8) 100%
    );
  }
  .hero-content {
    position: relative;
    margin-top: auto;
    display: grid;
    gap: 18px;
    align-items: end;
    padding-top: 28px;
    padding-bottom: 36px;
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.35);
  }
  @media (min-width: 900px) {
    .hero-content {
      grid-template-columns: 1.6fr 1fr;
      gap: 56px;
      padding-bottom: 44px;
    }
  }
  .hero-date {
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 14px;
  }
  h1 {
    font-size: clamp(2.5rem, min(7.2vw, calc(var(--fold, 100svh) * 0.125)), 6.3rem);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.045em;
  }
  .intro {
    font-size: 1.1rem;
    line-height: 1.5;
    max-width: 26em;
    color: rgba(255, 255, 255, 0.93);
  }
  .overview {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
  }
  .overview li {
    position: relative;
    border-top: 1px solid rgba(255, 255, 255, 0.42);
    padding: 18px 16px 28px 0;
    font-weight: 500;
    font-size: 0.95rem;
    line-height: 1.3;
  }
  .overview li::before {
    content: "";
    position: absolute;
    top: -5px;
    left: 0;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #1d1b18;
    border: 1px solid rgba(255, 255, 255, 0.85);
  }
  .overview span {
    display: block;
    margin-top: 3px;
    font-weight: 400;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.74);
  }
  .overview .here,
  .overview .here span {
    color: var(--sun);
  }
  .overview .here::before {
    background: var(--sun);
    border-color: var(--sun);
  }

  /* ---------- Timeline: date rail on the left, story on the right ---------- */
  .item,
  .block {
    --rail: 230px;
  }
  .item {
    display: grid;
  }
  .when {
    padding-top: 92px;
  }
  .month {
    font-size: 1.6rem;
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }
  .when .label {
    display: block;
    margin-top: 6px;
  }
  .here-tag {
    display: inline-block;
    margin-top: 12px;
    background: var(--sun);
    color: #141414;
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 4px 9px;
  }
  .body {
    position: relative;
    min-width: 0;
  }
  h2 {
    font-size: clamp(1.9rem, 4vw, 3.2rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.035em;
    max-width: 16em;
  }
  .lead {
    margin-top: 24px;
    font-size: 1.2rem;
    line-height: 1.55;
    max-width: 36em;
  }
  @media (min-width: 900px) {
    .item {
      grid-template-columns: var(--rail) 1fr;
    }
    .when {
      position: sticky;
      top: 0;
      align-self: start;
      padding-right: 32px;
    }
    .body {
      border-left: 1px solid var(--rule);
      padding: 92px 0 92px 64px;
    }
    .body::before {
      content: "";
      position: absolute;
      left: -6px;
      top: 103px;
      width: 11px;
      height: 11px;
      border-radius: 50%;
      background: var(--bg);
      border: 2px solid var(--accent);
    }
    .here .body::before {
      background: var(--sun);
      border-color: var(--sun);
      width: 15px;
      height: 15px;
      left: -8px;
      top: 101px;
    }
  }
  /* Phones and tablets: the line runs down the left edge, the date above each block. */
  @media (max-width: 899px) {
    .item {
      border-left: 1px solid var(--rule);
      padding-left: 24px;
    }
    .when {
      position: relative;
      padding-top: 64px;
    }
    .when::before {
      content: "";
      position: absolute;
      left: -30px;
      top: 71px;
      width: 11px;
      height: 11px;
      border-radius: 50%;
      background: var(--bg);
      border: 2px solid var(--accent);
    }
    .here .when::before {
      background: var(--sun);
      border-color: var(--sun);
    }
    .body {
      padding: 20px 0 24px;
    }
  }

  /* ---------- November 2026 ---------- */
  .photos {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 16px;
    margin-top: 44px;
  }
  .photos .big {
    grid-row: span 2;
  }
  .photos :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photos .small :global(img) {
    aspect-ratio: 3 / 2;
  }
  .photos :global(.gray) {
    filter: grayscale(1) contrast(1.05);
  }
  .facts {
    display: grid;
    gap: 0 48px;
    margin-top: 48px;
  }
  @media (min-width: 900px) {
    .facts {
      grid-template-columns: 1fr 1fr;
    }
  }
  .facts p {
    padding: 20px 0;
    border-top: 1px solid var(--rule);
    color: var(--muted);
  }
  .facts strong {
    display: block;
    color: var(--text);
    font-weight: 500;
    font-size: 1.25rem;
    letter-spacing: -0.015em;
    margin-bottom: 4px;
  }
  .boots {
    position: relative;
    margin-top: 56px;
    color: #fff;
  }
  .boots :global(img) {
    width: 100%;
    height: 660px;
    object-fit: cover;
    object-position: 50% 82%;
  }
  .boots-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 45%, rgba(0, 0, 0, 0.7) 100%);
  }
  .boots p {
    position: absolute;
    left: 36px;
    right: 36px;
    bottom: 32px;
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .weeks {
    margin-top: 56px;
  }
  .strip {
    display: grid;
    grid-template-columns: repeat(52, 1fr);
    gap: 3px;
    margin: 14px 0 16px;
  }
  .strip i {
    height: 30px;
    background: #e6e2d8;
  }
  .strip i.on {
    background: var(--accent);
  }
  .weeks-cap {
    font-size: 1.2rem;
    line-height: 1.5;
    max-width: 34em;
  }
  .weeks-cap strong {
    font-weight: 500;
  }

  /* ---------- December 2026: the money ---------- */
  .needs {
    margin-top: 36px;
    max-width: 620px;
  }
  .needs li {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 15px 0;
    border-top: 1px solid var(--rule);
    font-size: 1.15rem;
  }
  .needs li:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .needs .num {
    font-weight: 500;
  }
  .goal {
    margin-top: 44px;
    max-width: 620px;
  }
  .goal-big {
    font-size: clamp(2.6rem, 5.4vw, 4.2rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1;
  }
